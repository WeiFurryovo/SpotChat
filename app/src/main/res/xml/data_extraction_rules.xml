<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="sharedpref"
            path="spotchat_identity.xml" />
        <exclude
            domain="sharedpref"
            path="spotchat_trusted_peers.xml" />
        <exclude
            domain="sharedpref"
            path="spotchat_wear_state.xml" />
        <exclude
            domain="database"
            path="spotchat_replay.db" />
        <exclude
            domain="database"
            path="spotchat_replay.db-wal" />
        <exclude
            domain="database"
            path="spotchat_replay.db-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="sharedpref"
            path="spotchat_identity.xml" />
        <exclude
            domain="sharedpref"
            path="spotchat_trusted_peers.xml" />
        <exclude
            domain="sharedpref"
            path="spotchat_wear_state.xml" />
        <exclude
            domain="database"
            path="spotchat_replay.db" />
        <exclude
            domain="database"
            path="spotchat_replay.db-wal" />
        <exclude
            domain="database"
            path="spotchat_replay.db-shm" />
    </device-transfer>
</data-extraction-rules>
